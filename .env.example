# Polymarket 门户环境变量模板 —— 复制成 .env 再填值（.env 已被 gitignore，不会提交）。
# 后端(npm run server)会用 --env-file 读这里；前端 vite 自动读 VITE_ 开头的。

# ── 后端（builder 归因，必填才能下单）───────────────────────
# 来自 polymarket.com 设置页 builder 标签（保密，跟公开的 builder code 不是一回事）。
# 本地开发由 sign-server 读这里；生产部署到 Cloudflare Workers（wrangler secret put）
# 或 Deno Deploy（面板环境变量），别把 secret 提交进仓库。
POLYMARKET_BUILDER_API_KEY=
POLYMARKET_BUILDER_SECRET=
POLYMARKET_BUILDER_PASSPHRASE=

# sign-server 端口（可选，默认 8787；改了要和 vite proxy 目标一致）
SIGN_SERVER_PORT=8787

# 可选 Origin 白名单（逗号分隔的前端域名）。留空=允许所有来源。
# 只拦浏览器跨站滥用，是"减速带"不是"墙"（Origin 可被非浏览器伪造）；风险边界见部署说明。
# 例：SIGN_ALLOWED_ORIGINS=https://your-frontend.example.com,https://www.your-frontend.example.com
SIGN_ALLOWED_ORIGINS=

# ── 前端（可选）─────────────────────────────────────────────
# 远程签名端点。留空 -> 同源 /api/polymarket/sign（开发走 vite proxy 到本地 sign-server）。
# 生产双活：把 Workers / Deno Deploy 两个绝对地址分别填进 PRIMARY / FALLBACK（对等，无主从）。
# 前端会先探 PRIMARY，不通再退 FALLBACK。只填 PRIMARY 也行（无 fallback）。
VITE_SIGN_URL_PRIMARY=
VITE_SIGN_URL_FALLBACK=

# Polygon RPC（读授权/余额用），留空则用公共节点 https://polygon-rpc.com
VITE_POLYGON_RPC_URL=

# integrator 额外抽成：成交后从用户 Safe 转一笔到这个地址（与 builder 归因是两种收入）。
# 留空 / 0 则不收。
VITE_INTEGRATOR_FEE_ADDRESS=
VITE_INTEGRATOR_FEE_BPS=0
